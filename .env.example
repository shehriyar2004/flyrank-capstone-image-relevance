# The run command creates .env with random local demo secrets if missing.
POSTGRES_PASSWORD=replace-with-random-local-password
TENANT_A_KEY=replace-with-a-random-tenant-key-at-least-24-characters
TENANT_B_KEY=replace-with-a-different-random-tenant-key-at-least-24-characters
APP_PORT=3100
CALL_BUDGET=1000
VISION_MODEL=qwen3-vl:2b-instruct
EMBEDDING_MODEL=embeddinggemma:300m
# Inside Compose: DATABASE_URL and OLLAMA_URL are set by compose.yaml.
# For running individual processes outside Compose, set these explicitly:
# DATABASE_URL=postgresql://capstone:local-password@localhost:5432/capstone
# OLLAMA_URL=http://localhost:11434
# HOST=127.0.0.1
# PORT=3100
